{
  "name": "marketplace-os",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable, configuration-driven marketplace and lead-generation platform for high-ticket home and wellness categories in Mexico.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "blog:generate": "drizzle-kit generate --config=drizzle.blog.config.ts",
    "blog:migrate": "tsx scripts/blog-migrate.ts",
    "blog:agent": "tsx scripts/daily_agent.ts",
    "blog:backfill-images": "tsx scripts/backfill-hero-images.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "bootstrap:production": "tsx scripts/bootstrap-production.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "directory:import": "tsx scripts/directory-import.ts",
    "library:ingest": "tsx scripts/library-ingest.ts",
    "library:seed": "tsx scripts/library-seed.ts",
    "config:validate": "tsx scripts/config-validate.ts",
    "marketplace:create": "tsx scripts/marketplace-create.ts",
    "photos:fetch": "tsx scripts/fetch-photos.ts",
    "outbox:work": "tsx scripts/outbox-work.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "marked": "^18.0.7",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
