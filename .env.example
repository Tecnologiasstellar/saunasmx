# Copy to .env.local and fill in. Never commit .env files.

# Database
# Leave DATABASE_URL empty to use the embedded PGlite database in .pgdata/ (local dev + tests).
# Set it to a real Postgres connection string (Supabase/Neon) for preview/staging/production.
DATABASE_URL=

# Which host maps to which marketplace during local development.
# Format: hostname=marketplace-slug, comma separated.
LOCAL_HOST_MAP=localhost:3000=suanas-mx,pergolas.localhost:3000=pergolas-mx

# Public base host used to build canonical URLs in non-production environments.
APP_ENV=local

# Email adapter: "fake" logs to the outbox result, "resend" sends for real.
EMAIL_ADAPTER=fake
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# Session signing secret (32+ random chars). Generate with: openssl rand -hex 32
SESSION_SECRET=

# Magic-link requests allowed per client per hour. Only raise this for test runs
# that sign in as many users from one address; ignored when APP_ENV=production,
# where the brute-force limit stays at 5.
LOGIN_REQUESTS_PER_HOUR=
